# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Dashboard Supabase > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Facoltativo: URL pubblico dell'app, usato nel link d'accesso via email.
# Se manca, viene ricavato dalla richiesta (va bene in locale).
# NEXT_PUBLIC_SITE_URL=https://cronache.example.com
